{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "accuracy-audit.ts",
    "check-api-shape.ts",
    "check-cache-table.ts",
    "check-jul-headers.ts",
    "check-read-fields.ts",
    "create-cache-table-v2.ts",
    "create-cache-table.ts",
    "delete-jul-pos.ts",
    "delete-remaining-pos.ts",
    "discover-delete.ts",
    "discover-delete2.ts",
    "discover-delete3.ts",
    "discover-delete4.ts",
    "discover-delete5.ts",
    "e2e-test.ts",
    "extract-timing-test.ts",
    "flexibility-test.ts",
    "ping-nextgen.ts",
    "probe-product-create.ts",
    "run-style-cache-migration.ts",
    "search-products.ts",
    "show-headers.ts",
    "test-color-api.ts",
    "test-color-fields.ts",
    "test-color-readback.ts",
    "test-color-readback2.ts",
    "test-color-readback3.ts",
    "test-env.ts",
    "test-jul-buyfile.ts",
    "test-supabase-sql.ts",
    "upload-jul-to-nextgen.ts",
    "test-samples",
    "**/*-PF62XX6H.*"
  ]
}

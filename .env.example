[TEMPLATE]
# Supabase Configuration\r
# Get these values from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api\r
\r
NEXT_PUBLIC_SUPABASE_URL=your-project-url\r
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key\r
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key\r
SUPABASE_DB_SCHEMA=po_cutting\r
\r
# NextGen API Configuration\r
# Read-only API for PO validation and lookup\r
NEXTGEN_BASE_URL=https://nextgen.madison88.com\r
NEXTGEN_USERNAME=your-nextgen-username\r
NEXTGEN_PASSWORD=your-nextgen-password\r
\r
# NextGen Integration\r
# Set to false to disable all NextGen API calls (faster, uses only buy file + product sheet data)\r
NEXTGEN_ENABLED=true\r
\r
# NextGen WRITE/Test Environment (for PO Insert auto-upload)\r
# SAFETY: Write operations (insertPO/insertLine/insertSize) will REFUSE to run\r
# unless the base URL contains ":8443" (the test environment port).\r
# Production is https://nextgen.madison88.com (port 443) — NEVER use for writes.\r
NEXTGEN_WRITE_BASE_URL=https://nextgen.madison88.com:8443\r
NEXTGEN_WRITE_USERNAME=your-test-username\r
NEXTGEN_WRITE_PASSWORD=your-test-password\r
# Set to false to disable the auto-upload feature entirely\r
NEXTGEN_WRITE_ENABLED=true\r
\r
# NextGen Search Configuration\r
# Entity types to search across (default: 0,5,6,138,80,121,9,222,163,69,23,41,139,42)\r
NEXTGEN_SEARCH_ENTITY_TYPES=0,5,6,138,80,121,9,222,163,69,23,41,139,42\r
# Strip this prefix from buy file styles before searching NextGen (e.g., NF0)\r
NEXTGEN_STYLE_PREFIX_STRIP=NF0\r
# Delay between NextGen search requests in ms (default: 500)\r
NEXTGEN_SEARCH_DELAY_MS=500\r
NEXTGEN_REQUEST_TIMEOUT_MS=20000\r
\r
# Google Gemini API Configuration\r
# Used for OCR on image/PDF files and fallback for large Excel buy file extraction\r
GEMINI_API_KEY=your-gemini-api-key\r
\r
# Groq API Configuration\r
# Primary AI for Excel buy file extraction\r
GROQ_API_KEY=your-groq-api-key\r
\r
# Ollama AI Configuration\r
# Local/remote LLM for Excel header detection, column mapping, vision and text processing\r
# Local dev:  OLLAMA_BASE_URL=http://127.0.0.1:11434  (e.g. OLLAMA_MODEL=qwen3:14b)\r
# VPS/remote: OLLAMA_BASE_URL=http://5.223.78.194:11434 (e.g. OLLAMA_MODEL=qwen3:4b)\r
OLLAMA_BASE_URL=http://5.223.78.194:11434\r
OLLAMA_MODEL=qwen3:4b\r
OLLAMA_TIMEOUT=300\r
\r
# Optional split deployment: Netlify UI -> VPS processing API\r
NEXT_PUBLIC_PROCESSING_API_URL=https://po-cutting.5-223-78-194.sslip.io\r
ALLOWED_UPLOAD_ORIGINS=https://m88-po-cutting.netlify.app\r
